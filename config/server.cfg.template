// Configuración del servidor. start.sh genera config/server.cfg a partir de
// este archivo: no edites server.cfg directamente, cambiá esta plantilla.
// Los valores entre llaves dobles los completa start.sh.

hostname "CS 1.6 propio"
sv_lan 0
public 0
sv_password ""
rcon_password "{{RCON}}"
sv_cheats {{CHEATS}}

// Partida
mp_timelimit 0
mp_roundtime 5
mp_freezetime 2
mp_startmoney 16000
mp_buytime 9
mp_friendlyfire 0
mp_autoteambalance 0
mp_limitteams 0
mp_autokick 0
mp_consistency 0

// Bots (para ver los personajes en movimiento). Si el servidor no trae bots,
// estas líneas no hacen nada.
bot_quota 4
bot_difficulty 0
bot_chatter "off"
bot_join_after_player 1
