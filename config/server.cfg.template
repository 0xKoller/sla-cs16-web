// Configuración del servidor de CS. start.sh genera config/server.cfg a partir de
// este archivo cada vez que arranca: cambiá esta plantilla, no server.cfg.
// Los valores entre llaves dobles los completa start.sh.
// Basada en la configuración de CSweb (MIT).

hostname "{{NOMBRE}}"
rcon_password "{{RCON}}"
sv_password ""
sv_lan 1
sv_cheats {{CHEATS}}
pausable 0
sv_aim 0
sv_allowupload 0
sv_allowdownload 1
allow_spectators 1
sv_timeout 120

// Red
sys_ticrate 128
sv_maxrate 100000
sv_minrate 25000
sv_maxupdaterate 101
sv_minupdaterate 30

// Reglas de juego
mapcyclefile mapcycle.txt
mp_timelimit 0
mp_roundtime 5
mp_freezetime 2
mp_buytime 9
mp_c4timer 35
mp_startmoney 16000
mp_friendlyfire 0
mp_autoteambalance 1
mp_limitteams 2
mp_autokick 0
mp_flashlight 1
mp_footsteps 1
mp_consistency 0

// Bots YaPB (la cantidad y la dificultad salen de .env: BOTS y BOTS_DIFICULTAD)
yb_join_after_player 0
yb_quota_mode "normal"

exec listip.cfg
exec banned.cfg
