# HTTPS automático (Let's Encrypt) para el modo online. DOMINIO lo pone start.sh (en .env
# como DOMINIO_CADDY): <tu-ip>.sslip.io y, si tenés, también tu dominio (juego.ejemplo.com).
{$DOMINIO} {
	encode zstd gzip
	reverse_proxy web:27016
	header {
		Strict-Transport-Security "max-age=31536000"
		Permissions-Policy "camera=(self), microphone=()"
		-Server
	}
}
